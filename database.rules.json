{
  "rules": {
    "users": {
      ".read": "true",
      "$firebaseId": {
        ".write": "auth != null && auth.uid === $firebaseId"
      },
      ".indexOn": ["uid", "email"]
    },
    
    "registrations": {
      ".read": "true",
      ".indexOn": ["leaderId"], 
      "$regId": {
        ".write": "auth != null"
      }
    },

    "merch_orders": {
      ".read": "false",
      ".write": "false",
      ".indexOn": ["uid"]
    },
    
    "inquiries": {
      ".read": "false",
      ".write": "true",
      ".indexOn": ["status", "email", "createdAt"] 
    },
    
    // CONTENT MANAGEMENT (ALLOW WRITES IF AUTHENTICATED)
    "judges": { ".read": "true", ".write": "auth != null" },
    "faculty": { ".read": "true", ".write": "auth != null" },
    "coreTeam": { ".read": "true", ".write": "auth != null" },
    "sponsors": { ".read": "true", ".write": "auth != null" },
    
    // EVENT SETTINGS (Registration controls, timers, etc.)
    "eventSettings": {
      ".read": "true",
      ".write": "auth != null"
    },

    "settings": {
      "merch": {
        ".read": "true",
        ".write": "false"
      }
    },
    
    "admins": {
      ".read": "false",
      ".write": "false",
      ".indexOn": ["email"]
    }
  }
}
